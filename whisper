#!/usr/bin/env python3
"""Convenient CLI entry point for the voice assistant.
Running this script as `whisper` will start the keyboard-activated Voice Assistant
using the global hotkey (default: CTRL + SPACE).

Usage:
    $ whisper
"""

import os
import sys

# Ensure the project root is on PYTHONPATH so relative imports work
project_root = os.path.abspath(os.path.dirname(__file__))
if project_root not in sys.path:
    sys.path.insert(0, project_root)

from main import main

if __name__ == "__main__":
    main()
